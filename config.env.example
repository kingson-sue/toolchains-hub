# =============================================================================
# Toolchains Hub 配置文件
# 复制为 config.env 后按目标机器修改：  cp config.env.example config.env
# =============================================================================

# ---- 数据根目录（IDF 源码 / 工具链放这里，便于整包迁移）----
# 默认：本工程下的 data/；也可改成绝对路径
IDF_DATA_ROOT=

# ---- Docker 镜像 ----
IMAGE_NAME=toolchains-hub
IMAGE_TAG=multi
# 容器名与 Compose project 默认会按宿主机用户名生成，避免多人同机冲突。
CONTAINER_NAME=
COMPOSE_PROJECT_NAME=
# 基础镜像（国内访问 Docker Hub 超时请用镜像站；能直连则可改回 ubuntu:22.04）
# 备选:
#   docker.m.daocloud.io/library/ubuntu:22.04
#   mirror.ccs.tencentyun.com/library/ubuntu:22.04
#   ubuntu:22.04
BASE_IMAGE=docker.m.daocloud.io/library/ubuntu:22.04
# true：仅 Docker 命令使用 sudo；Git 仍使用当前普通用户及其 SSH 密钥
# 若当前用户已加入 docker 组，可设为 false
DOCKER_USE_SUDO=true

# ---- SSH ----
# 宿主机端口 -> 容器 22；留空时部署会从 SSH_HOST_PORT_START 起自动选择空闲端口并写回 config.env
SSH_HOST_PORT=
SSH_HOST_PORT_START=3022
# 容器内登录密码（默认 SSH 用户 usmile，root 也同步设置）
SSH_PASSWORD=usmile123

# ---- 工程工作区（宿主机路径，映射进容器 ~/workspace）----
# 留空则使用本工程下的 workspace/（与 data/ 同级，不放在 data 里）
IDF_WORKSPACE=
# 容器登录用户与宿主机 UID/GID 对齐（默认取当前用户；一般不用改）
# HOST_UID=
# HOST_GID=

# ---- 是否挂载宿主机 ~/.ssh 进容器（方便容器内 git push）----
# true / false
MOUNT_HOST_SSH=true

# ---- 部署时是否自动安装工具链 + Python venv ----
# 首次部署建议 true；已有 tools 目录时可 false 以加快部署
INSTALL_TOOLS=true

# ---- install.sh 目标芯片（逗号分隔，all 表示全部）----
IDF_INSTALL_TARGETS=all

# ---- 国内下载加速 ----
# ESP-IDF 工具下载：不要加 https://，idf_tools.py 会自动补
IDF_GITHUB_ASSETS=dl.espressif.com/github_assets
# Python 包下载源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
PIP_DEFAULT_TIMEOUT=120

# =============================================================================
# ESP-IDF 6.0.2（GitHub 官方正式版）
# =============================================================================
IDF_NAME=esp-idf-v6.0.2
IDF_URL=https://github.com/espressif/esp-idf.git
IDF_REF=v6.0.2
IDF_TOOLS_DIR=espressif
IDF_PYTHON_ENV=idf6.0.2_py3.10_env
IDF_VERSION=6.0.2
